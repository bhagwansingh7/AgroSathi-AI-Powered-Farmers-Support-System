# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_root
DB_NAME=agrosathi
DB_USER=agrosathi
DB_PASSWORD=change_me_db

# ---- Auth ----
# Generate with: openssl rand -hex 48
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- AI (any OpenAI-compatible chat/embeddings API) ----
# Leave AI_API_KEY empty to run without an LLM (RAG search still works with the local embedder).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# "provider" uses AI_EMBEDDING_MODEL via the API, "local" uses the built-in hashing embedder
EMBEDDING_PROVIDER=local

# ---- Weather (https://www.weatherapi.com — free tier works) ----
WEATHER_API_KEY=
WEATHER_CACHE_TTL_SECONDS=1800
WEATHER_ALERT_JOB_MINUTES=60

# ---- URLs ----
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
REDIS_URL=redis://redis:6379

# ---- Misc ----
LOG_LEVEL=info
